# Copy to .env and fill in.
AGENT_SUDO_IMAGE=ghcr.io/tpurtell/agent-sudo-service:latest
AGENT_SUDO_PUBLIC_URL=https://agent-sudo.example-tailnet.ts.net
AGENT_SUDO_ADMIN_EMAIL=you@example.com
AGENT_SUDO_ADVISOR_URL=https://openrouter.ai/api/v1
AGENT_SUDO_ADVISOR_MODEL=deepseek/deepseek-v4-flash
AGENT_SUDO_ADVISOR_KEY=
# First-run setup link token (optional; otherwise one is printed in the log).
AGENT_SUDO_SETUP_TOKEN=

# Tailscale profile. Leave TS_AUTHKEY empty to approve the device through the login
# link printed by `docker compose logs tailscale`, or set an auth key for unattended setup.
TS_AUTHKEY=
TS_HOSTNAME=agent-sudo

# nginx profile
HTTPS_PORT=8443
TLS_CERT=./certs/fullchain.pem
TLS_KEY=./certs/privkey.pem
